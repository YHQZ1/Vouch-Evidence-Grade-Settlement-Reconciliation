{
  "name": "vouch-review-interface",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:generate": "node scripts/generate-api-types.mjs",
    "api:check": "node scripts/check-api-contract.mjs",
    "e2e": "playwright test",
    "e2e:scripted": "playwright test --config playwright.scripted.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,mjs,css}\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.{ts,tsx,js,mjs}\" \"*.{js,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,mjs,css}\" \"scripts/**/*.{js,mjs}\" \"tests/**/*.{ts,tsx,js,mjs}\" \"*.{js,mjs,ts}\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
